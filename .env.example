# Copy to .env for local overrides. Compose already sets these for the dev
# stack, so you only need this file when running outside Compose.
#
# .env is git-ignored. Never commit real credentials.

APP_ENV=local

# Dev (Compose): the hostname `db` resolves on the compose network.
DATABASE_URL=postgresql+psycopg://careroute:careroute@db:5432/careroute

# Azure: TLS is required. See docs/AZURE.md.
# DATABASE_URL=postgresql+psycopg://user:password@server.postgres.database.azure.com:5432/careroute?sslmode=require

# JWT signing key. Unset is fine for APP_ENV=local/test (a dev default is
# used); any other APP_ENV refuses to start without a real one. Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=
# JWT_TTL_MINUTES=60
